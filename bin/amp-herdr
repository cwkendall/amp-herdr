#!/usr/bin/env node
// amp-herdr: installs the Amp ↔ Herdr integration, opens and syncs Amp threads
// in Herdr, and restarts outdated Herdr sessions without losing Amp threads.

import { spawnSync } from 'node:child_process'
import { copyFileSync, existsSync, mkdirSync, readFileSync, realpathSync, rmSync } from 'node:fs'
import { homedir } from 'node:os'
import { basename, dirname, join, resolve } from 'node:path'
import { createInterface } from 'node:readline/promises'
import { fileURLToPath } from 'node:url'
import { parseArgs } from 'node:util'

const ROOT = realpathSync(resolve(dirname(fileURLToPath(import.meta.url)), '..'))
const { version: VERSION } = JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf8'))
const PLUGIN_ID = 'amp-herdr'
const AMP_PLUGIN = join(ROOT, 'amp', 'amp-herdr.ts')
const AMP_PLUGIN_TARGET = join(
	process.env.XDG_CONFIG_HOME || join(homedir(), '.config'),
	'amp',
	'plugins',
	'amp-herdr.ts',
)
const MANAGED_MARKER = '// managed by amp-herdr'
const SYNC_LIMIT = 10
const THREAD_ID = /^T-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

const USAGE = `Usage: amp-herdr <command> [options]

Commands:
  install [--amp-only]          Install the Amp plugin and link the Herdr plugin
  uninstall                     Remove both plugins
  status                        Show what is installed and which panes report Amp threads
  open [thread-id]              Open an Amp thread in Herdr, or pick one from recent threads
  sync [--since 24h] [--dry-run]  Open recently updated Amp threads that are not open yet
  upgrade [session] [--yes]     Stop outdated Herdr sessions that can be restored safely

Options:
  --session <name>              Herdr session for open and sync (default: current)
  -h, --help                    Show this help
  -v, --version                 Show the version`

function fail(message) {
	console.error(`amp-herdr: ${message}`)
	notify('Amp', message)
	process.exit(1)
}

function run(command, args) {
	// On Windows, amp is a .cmd shim, which Node runs only through a shell and as
	// one command string; herdr is a real executable. Amp only ever receives fixed
	// flags, numbers, and validated thread IDs, so nothing needs shell quoting.
	// Thread exports can be many megabytes, well over spawnSync's 1 MB default.
	const shell = process.platform === 'win32' && command === 'amp'
	const result = shell
		? spawnSync([command, ...args].join(' '), { encoding: 'utf8', shell, maxBuffer: Infinity })
		: spawnSync(command, args, { encoding: 'utf8', maxBuffer: Infinity })
	if (result.error) fail(`cannot run ${command}: ${result.error.message}`)
	if (result.status !== 0) {
		const output = (result.stderr || result.stdout).trim()
		let message = output
		try {
			message = JSON.parse(output).error?.message ?? output
		} catch {}
		fail(message || `${command} ${args.join(' ')} exited with ${result.status}`)
	}
	return result.stdout
}

function herdr(session, ...args) {
	const output = run(process.env.HERDR_BIN_PATH || 'herdr', [
		...(session ? ['--session', session] : []),
		...args,
	])
	if (!output.trim()) return undefined
	const json = JSON.parse(output)
	return json.result ?? json
}

// Plugin actions run without a terminal, so they report through Herdr instead.
function notify(title, body) {
	if (!process.env.HERDR_PLUGIN_ID) return
	spawnSync(process.env.HERDR_BIN_PATH || 'herdr', ['notification', 'show', title, '--body', body])
}

function threadCwd(thread) {
	try {
		const cwd = fileURLToPath(thread.tree)
		return existsSync(cwd) ? cwd : undefined
	} catch {
		return undefined // no tree, not a file URL, or a path from another OS
	}
}

function recentThreads(limit) {
	return JSON.parse(run('amp', ['threads', 'list', '--json', '--limit', String(limit)]))
}

function threadByID(id) {
	if (!THREAD_ID.test(id)) fail(`not an Amp thread ID: ${id}`)
	const thread = JSON.parse(run('amp', ['threads', 'export', id]))
	return { id, title: thread.title, tree: thread.env?.initial?.trees?.[0]?.uri }
}

// Panes running the Amp plugin carry their thread in the amp_thread token.
// Herdr keeps tokens after a crash, so trust one only while Amp is running.
function ampThread(pane) {
	return pane.agent === 'amp' ? pane.tokens?.amp_thread : undefined
}

function sessionIndex(session) {
	const threads = new Map()
	const workspaces = new Map()
	for (const pane of herdr(session, 'pane', 'list').panes) {
		if (ampThread(pane)) threads.set(ampThread(pane), pane.pane_id)
		if (pane.cwd && !workspaces.has(pane.cwd)) workspaces.set(pane.cwd, pane.workspace_id)
	}
	return { threads, workspaces }
}

function openThread(session, index, thread, { focus }) {
	const cwd = threadCwd(thread) ?? homedir()
	if (!THREAD_ID.test(thread.id)) fail(`not an Amp thread ID: ${thread.id}`)
	const existing = index.threads.get(thread.id)
	if (existing) {
		if (focus) herdr(session, 'agent', 'focus', existing)
		return false
	}
	const focusFlag = focus ? '--focus' : '--no-focus'
	const label = (thread.title || thread.id).slice(0, 80)
	let paneID
	const workspaceID = index.workspaces.get(cwd)
	if (workspaceID) {
		paneID = herdr(session, 'tab', 'create', '--workspace', workspaceID, '--cwd', cwd, '--label', label, focusFlag)
			.root_pane.pane_id
	} else {
		const created = herdr(session, 'workspace', 'create', '--cwd', cwd, '--label', basename(cwd), focusFlag)
		herdr(session, 'tab', 'rename', created.tab.tab_id, label)
		index.workspaces.set(cwd, created.workspace.workspace_id)
		paneID = created.root_pane.pane_id
	}
	herdr(session, 'pane', 'run', paneID, `amp threads continue ${thread.id}`)
	index.threads.set(thread.id, paneID)
	return true
}

function ago(timestamp) {
	const minutes = Math.max(0, Math.round((Date.now() - Date.parse(timestamp)) / 60000))
	if (minutes < 60) return `${minutes}m`
	if (minutes < 48 * 60) return `${Math.round(minutes / 60)}h`
	return `${Math.round(minutes / 1440)}d`
}

async function pickThread(session) {
	const index = sessionIndex(session)
	const threads = recentThreads(Math.max(5, (process.stdout.rows || 24) - 3))
	threads.forEach((thread, i) => {
		const project = threadCwd(thread) ? basename(threadCwd(thread)) : '-'
		const open = index.threads.has(thread.id) ? '●' : ' '
		console.log(`${String(i + 1).padStart(2)} ${open} ${thread.title || thread.id}  \x1b[2m${project} · ${ago(thread.updated)}\x1b[0m`)
	})
	const prompt = createInterface({ input: process.stdin, output: process.stdout })
	const answer = (await prompt.question('\nOpen thread (number, Enter to cancel): ')).trim()
	prompt.close()
	const thread = threads[Number(answer) - 1]
	if (thread) openThread(session, index, thread, { focus: true })
}

async function open(session, id) {
	if (id) {
		const index = sessionIndex(session)
		openThread(session, index, index.threads.has(id) ? { id } : threadByID(id), { focus: true })
	} else if (process.stdin.isTTY) {
		await pickThread(session)
	} else if (process.env.HERDR_PLUGIN_ID) {
		herdr(session, 'plugin', 'pane', 'open', '--plugin', PLUGIN_ID, '--entrypoint', 'picker')
	} else {
		fail('open needs a thread ID or a terminal')
	}
}

function parseDuration(value) {
	const match = /^(\d+)([mhd])$/.exec(value)
	if (!match) fail(`invalid duration ${value}; use a number followed by m, h, or d`)
	return Number(match[1]) * { m: 60000, h: 3600000, d: 86400000 }[match[2]]
}

function sync(session, since, dryRun) {
	const cutoff = Date.now() - parseDuration(since)
	const index = sessionIndex(session)
	const recent = recentThreads(200).filter((thread) => Date.parse(thread.updated) >= cutoff)
	const candidates = recent.filter((thread) => !index.threads.has(thread.id))
	const openable = candidates.filter(threadCwd)
	// Each thread starts a full Amp client, so one sync opens at most a few; the
	// next sync opens the rest.
	const batch = openable.slice(0, SYNC_LIMIT)
	for (const thread of batch) {
		console.log(`${dryRun ? 'Would open' : 'Opening'} ${thread.title || thread.id} (${threadCwd(thread)})`)
		if (!dryRun) openThread(session, index, thread, { focus: false })
	}
	const left = openable.length - batch.length
	const skipped = candidates.length - openable.length
	const summary = `${[
		`${dryRun ? 'Would open' : 'Opened'} ${batch.length} thread(s) updated in the last ${since}`,
		`${recent.length - candidates.length} already open`,
		left && `${left} more on the next sync`,
		skipped && `${skipped} skipped without a local directory`,
	]
		.filter(Boolean)
		.join('; ')}.`
	console.log(summary)
	notify('Amp threads synced', summary)
}

function installAmpPlugin() {
	if (existsSync(AMP_PLUGIN_TARGET)) {
		const current = readFileSync(AMP_PLUGIN_TARGET, 'utf8')
		if (!current.includes(MANAGED_MARKER)) fail(`${AMP_PLUGIN_TARGET} exists and is not managed by amp-herdr`)
		if (current === readFileSync(AMP_PLUGIN, 'utf8')) return false
	}
	mkdirSync(dirname(AMP_PLUGIN_TARGET), { recursive: true })
	copyFileSync(AMP_PLUGIN, AMP_PLUGIN_TARGET)
	return true
}

function herdrPlugin() {
	return herdr(undefined, 'plugin', 'list', '--json').plugins.find((plugin) => plugin.plugin_id === PLUGIN_ID)
}

// The Herdr plugin's build and startup hooks pass --amp-only.
function install(ampOnly) {
	if (ampOnly) {
		if (installAmpPlugin()) console.log(`Updated ${AMP_PLUGIN_TARGET}`)
		return
	}
	const plugin = herdrPlugin()
	// A copy from `herdr plugin install` keeps the Amp plugin current through its
	// hooks; installing a second copy would make the two overwrite each other.
	if (plugin?.source?.kind === 'github') {
		return console.log(`Herdr already manages amp-herdr (${plugin.plugin_root}); nothing to install.`)
	}
	installAmpPlugin()
	console.log(`Amp plugin: ${AMP_PLUGIN_TARGET}`)
	// Herdr stores the resolved path, which a package upgrade replaces, and rereads
	// the manifest there on start. Relink only when that path changed: linking
	// also re-enables a plugin the user disabled.
	if (plugin?.plugin_root !== ROOT) {
		herdr(undefined, 'plugin', 'link', ROOT)
		console.log(`Herdr plugin: linked ${ROOT}`)
	}
	console.log('Running Amp sessions pick up the plugin after "plugins: reload" or a restart.')
}

function uninstall() {
	if (existsSync(AMP_PLUGIN_TARGET) && readFileSync(AMP_PLUGIN_TARGET, 'utf8').includes(MANAGED_MARKER)) {
		rmSync(AMP_PLUGIN_TARGET)
		console.log(`Removed ${AMP_PLUGIN_TARGET}`)
	}
	const plugin = herdrPlugin()
	if (plugin?.source?.kind === 'local') {
		herdr(undefined, 'plugin', 'unlink', PLUGIN_ID)
		console.log('Unlinked the Herdr plugin.')
	} else if (plugin) {
		console.log(`Remove the Herdr plugin with: herdr plugin uninstall ${PLUGIN_ID}`)
	}
}

function runningSessions() {
	return herdr(undefined, 'session', 'list', '--json').sessions.filter((session) => session.running)
}

function status() {
	const installed = existsSync(AMP_PLUGIN_TARGET)
	const current = installed && readFileSync(AMP_PLUGIN_TARGET, 'utf8') === readFileSync(AMP_PLUGIN, 'utf8')
	const plugin = herdrPlugin()
	console.log(`amp-herdr ${VERSION}`)
	console.log(`Amp plugin:   ${installed ? (current ? 'installed' : 'outdated') : 'missing'} (${AMP_PLUGIN_TARGET})`)
	console.log(
		`Herdr plugin: ${plugin ? `${plugin.source?.kind ?? 'local'}${plugin.enabled ? '' : ', disabled'} (${plugin.plugin_root})` : 'missing'}`,
	)
	for (const session of runningSessions()) {
		const panes = herdr(session.name, 'pane', 'list').panes
		const amp = panes.filter((pane) => pane.agent === 'amp')
		const reporting = amp.filter(ampThread)
		console.log(`Session ${session.name}: ${amp.length} Amp pane(s), ${reporting.length} reporting a resumable thread`)
	}
}

// The same shell names Herdr recognises (is_pane_shell_process_name).
const SHELL = /^-?(sh|bash|dash|zsh|fish|ksh|mksh|csh|tcsh|elvish|xonsh|nu|pwsh|powershell|cmd)(\.exe)?$/i
const isShell = (name = '') => SHELL.test(name)

// Every process's children and name, read once per check. A failure stops the
// command, so a pane is never judged without this information.
function processTable() {
	const output =
		process.platform === 'win32'
			? run('powershell', [
					'-NoProfile',
					'-Command',
					'Get-CimInstance Win32_Process | ForEach-Object { "$($_.ProcessId) $($_.ParentProcessId) $($_.Name)" }',
				])
			: run('ps', ['-A', '-o', 'pid=,ppid=,comm='])
	const children = new Map()
	const names = new Map()
	for (const line of output.trim().split(/\r?\n/)) {
		const [pid, ppid, ...name] = line.trim().split(/\s+/)
		names.set(Number(pid), name.join(' ').split(/[\\/]/).pop())
		children.set(Number(ppid), [...(children.get(Number(ppid)) ?? []), Number(pid)])
	}
	return { children, names }
}

// Stopping a session kills every process in its panes, including suspended and
// background jobs. A pane survives only when it is an idle shell with no other
// processes, or an idle agent that Herdr resumes natively or through an Amp
// thread report and that runs nothing else beside it.
function blockers(session) {
	const { children, names } = processTable()
	const reasons = []
	for (const pane of herdr(session, 'pane', 'list').panes) {
		const where = `${pane.pane_id} (${pane.cwd ?? 'unknown directory'})`
		const resumable = pane.agent_session || ampThread(pane)
		if (resumable && !['idle', 'done'].includes(pane.agent_status)) {
			reasons.push(`${where}: ${pane.agent} is ${pane.agent_status}`)
			continue
		}
		const info = herdr(session, 'pane', 'process-info', '--pane', pane.pane_id).process_info
		if (!info.shell_pid) continue // the pane's process has already exited
		const foreground = info.foreground_processes ?? [] // Herdr omits an empty list
		let shell = info.shell_pid
		// Herdr looks through a Scoop-style shim that runs one shell, and so do we.
		const [only, ...more] = children.get(shell) ?? []
		if (process.platform === 'win32' && only && !more.length && isShell(names.get(only))) shell = only
		// Children of the shell outside the foreground are background or suspended jobs.
		const jobs = (children.get(shell) ?? []).filter((pid) => !foreground.some((process) => process.pid === pid))
		if (resumable) {
			// shortcut: Windows has no foreground process group, so a job there cannot
			// be told apart from the agent; idle agents on Windows are trusted.
			if (process.platform === 'win32' || jobs.length === 0) continue
		} else if (
			[info.shell_pid, shell].includes(info.foreground_process_group_id) &&
			foreground.length > 0 &&
			foreground.every((process) => isShell(process.name)) &&
			jobs.length === 0
		) {
			continue
		}
		const running = [...new Set([...foreground.map((process) => process.name), ...jobs.map((pid) => names.get(pid))])]
		reasons.push(`${where} is running ${running.join(', ') || 'a job Herdr cannot inspect'}`)
	}
	return reasons
}

async function upgrade(name, yes) {
	const sessions = runningSessions().filter((session) => !name || session.name === name)
	if (name && sessions.length === 0) fail(`Herdr session ${name} is not running`)
	// HERDR_BIN_PATH can name the binary an old server started from, so ask the
	// herdr on PATH which version is installed now.
	const client = JSON.parse(run('herdr', ['status', 'client', '--json']))
	const installed = (client.result ?? client).version
	const plan = []
	let blocked = false
	for (const session of sessions) {
		const server = herdr(session.name, 'status', 'server', '--json')
		if (!server.restart_needed && !server.server_binary_stale && server.version === installed) {
			console.log(`Session ${session.name} is current (${server.version}).`)
			continue
		}
		const reasons =
			process.env.HERDR_SOCKET_PATH === session.socket_path
				? ['this command is running inside it; run it from another terminal']
				: blockers(session.name)
		if (reasons.length) {
			blocked = true
			console.log(`Session ${session.name} (${server.version}) cannot restart safely:`)
			for (const reason of reasons) console.log(`  ${reason}`)
			continue
		}
		console.log(`Session ${session.name} will restart from ${server.version} to ${installed}.`)
		plan.push(session.name)
	}
	if (plan.length === 0) process.exit(blocked ? 1 : 0)
	if (!yes) {
		if (!process.stdin.isTTY) fail('rerun with --yes to stop these sessions')
		const prompt = createInterface({ input: process.stdin, output: process.stdout })
		const answer = (await prompt.question(`Stop ${plan.length} session(s)? [y/N] `)).trim()
		prompt.close()
		if (!/^y(es)?$/i.test(answer)) return console.log('Cancelled.')
	}
	for (const session of plan) {
		const reasons = blockers(session) // panes may have changed while the prompt was open
		if (reasons.length) {
			blocked = true
			console.log(`Session ${session} changed and cannot restart safely:\n  ${reasons.join('\n  ')}`)
			continue
		}
		herdr(undefined, 'session', 'stop', session, '--json')
		console.log(`Stopped ${session}. Reattach with: herdr${session === 'default' ? '' : ` --session ${session}`}`)
	}
	if (blocked) process.exit(1)
}

const { values, positionals } = parseArgs({
	allowPositionals: true,
	options: {
		session: { type: 'string' },
		since: { type: 'string', default: '24h' },
		'dry-run': { type: 'boolean' },
		'amp-only': { type: 'boolean' },
		yes: { type: 'boolean' },
		help: { type: 'boolean', short: 'h' },
		version: { type: 'boolean', short: 'v' },
	},
})
const [command, argument] = positionals

if (values.version) console.log(VERSION)
else if (values.help || !command) console.log(USAGE)
else if (command === 'install') install(values['amp-only'])
else if (command === 'uninstall') uninstall()
else if (command === 'status') status()
else if (command === 'open') await open(values.session, argument)
else if (command === 'sync') sync(values.session, values.since, values['dry-run'])
else if (command === 'upgrade') await upgrade(argument, values.yes)
else fail(`unknown command: ${command}\n\n${USAGE}`)
